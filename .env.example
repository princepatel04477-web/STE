# Surat Textile Expo 2026 - Environment Variables

# Exhibitor Portal Password (Default: STE2026)
EXHIBITOR_PASSWORD="STE2026"

# Session JWT Secret Key
JWT_SECRET="ste-exhibitor-portal-secret-key-2026"

# Google Sheets Webhook URL
# Follow instructions to create a Google Web App Webhook URL and paste here:
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Shared secret for the INCOMING sheet sync, POST /api/webhooks/google-sheets.
# That endpoint rewrites exhibitor rows, so it accepts nothing without this:
# leave it unset and every request is refused. The Apps Script must send it as
# an X-Webhook-Secret header (or Authorization: Bearer <secret>).
SHEETS_WEBHOOK_SECRET=""

# Canonical public origin. Set this on the Vercel PRODUCTION environment only —
# preview deployments fall back to VERCEL_URL so they stay self-consistent and
# are served noindex. Leaving it unset in production defaults to www.stesurat.com.
NEXT_PUBLIC_SITE_URL="https://www.stesurat.com"

# ---------------------------------------------------------------------------
# Supabase (primary storage + database)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------------------------------------------------
# Google Drive mirror for exhibitor logos & CDR artwork
# ---------------------------------------------------------------------------
# Uploads land in: <parent folder>/<Brand Name>/<Brand Name> - Logo.png
# Supabase Storage is the source of truth; Drive is a mirror for the print team.

# The "STE Logos" parent folder id (from the folder's URL).
GOOGLE_DRIVE_PARENT_FOLDER_ID="1_6t-lfH0ha4BF1MxP2nsry6zmjmUFFcm"

# --- Option 1 (recommended): Apps Script web app -------------------------
# Deploy scripts/ste-drive-uploader.gs — see the header of that file for the
# 2-minute setup. Required when the parent folder lives in a personal Gmail
# Drive, because service accounts have no storage quota of their own.
GOOGLE_DRIVE_WEBAPP_URL=""
GOOGLE_DRIVE_WEBAPP_TOKEN=""

# --- Option 2: OAuth refresh token ---------------------------------------
# Files are owned by (and count against the quota of) the consenting account.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""

# --- Option 3: Service account -------------------------------------------
# Only works for a Google Workspace *Shared Drive*, or with domain-wide
# delegation via GOOGLE_IMPERSONATED_USER_EMAIL. It will fail with
# "Service Accounts do not have storage quota" against a personal My Drive.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_IMPERSONATED_USER_EMAIL=""
