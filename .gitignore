# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# sqlite database & local data store
/data/

.claude/

# Generated Apps Script copy (contains the deployment token)
scripts/*.generated.gs
.env*
~$*
*.csv

# Exhibitor artwork pulled down from Drive to work on locally. Nothing in the
# app reads it and the raw .cdr set alone is 25MB, so it stays out of the repo
# and out of the deployment upload - vercel falls back to this file when there
# is no .vercelignore.
/exhibitor_logos_raw/
/exhibitor_logos_pdf/

# Allotment exports. Generated from the data in src/data, never read back.
/STE_Stall_Allotments*.xlsx
